APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth providers (Socialstream)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional operator-managed encrypted file backup executor (disabled until configured)
HOSTING_BACKUP_ROOT=
HOSTING_RESTORE_ROOT=
HOSTING_BACKUP_KEY=

SEED_ADMIN_PASSWORD=

# Optional operator-owned PowerDNS cluster publisher (HTTPS API origins).
# Bind this source to one inventory team, zone UUID and domain before enabling it.
HOSTING_DNS_TEAM_ID=
HOSTING_DNS_ZONE_ID=
HOSTING_DNS_DOMAIN=
HOSTING_DNS_NS1_URL=
HOSTING_DNS_NS1_KEY=
HOSTING_DNS_NS2_URL=
HOSTING_DNS_NS2_KEY=

# Optional Kubernetes provisioning API; credentials stay outside tenant workloads.
HOSTING_KUBERNETES_URL=
HOSTING_KUBERNETES_TOKEN=
HOSTING_KUBERNETES_CA=

# Optional sharded Redis/Valkey cache. Keep Horizon's default Redis unsharded.
# REDIS_CACHE_CONNECTION=cache-cluster
# REDIS_CACHE_CLUSTER_NODES=tls://cache-0.example:6379,tls://cache-1.example:6379
REDIS_CACHE_CLUSTER_USERNAME=default
REDIS_CACHE_CLUSTER_PASSWORD=
REDIS_CACHE_CLUSTER_CA=
