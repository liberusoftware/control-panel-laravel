{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "liberusoftware/module-control-panel-accounts",
  "description": "Control Panel customer, reseller, package, quota, delegation, branding, and suspension boundary.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {"psr-4": {"Liberu\\ControlPanel\\Accounts\\": "src/"}},
  "autoload-dev": {"psr-4": {"Liberu\\ControlPanel\\Accounts\\Tests\\": "tests/"}},
  "extra": {"liberu": {"name": "control-panel-accounts"}},
  "version": "1.0.0",
  "require-dev": {"pestphp/pest": "^5.0"},
  "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
}
