{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "control-panel-web-hosting",
  "display_name": "Control Panel Web Hosting",
  "description": "Domains, virtual hosts, runtimes, SSL, redirects, logs, and applications.",
  "version": "1.0.0",
  "category": "capability",
  "provider": "Liberu\\ControlPanel\\WebHosting\\WebHostingServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {"liberusoftware/module-manager": "^1.0"}
  },
  "capabilities": ["control-panel.web-hosting"],
  "features": [
    "Domain lifecycle and validation",
    "Virtual host desired state",
    "Runtime, redirect, and MIME metadata",
    "Monthly disk and bandwidth usage records",
    "Certificate and application references",
    "Git repository deployment configuration and webhook security",
    "Hotlink protection",
    "Directory protection",
    "Custom error pages",
    "Domain cron jobs and execution history",
    "Subdomain lifecycle and redirects"
  ],
  "default_enabled": false
}
