  "type": "liberu-module",
  "license": "MIT",
  "require": {"php": "^8.5", "illuminate/database": "^13.38.0", "illuminate/events": "^13.38.0", "illuminate/support": "^13.38.0", "illuminate/validation": "^13.38.0", "phpseclib/phpseclib": "^4.0.2", "liberusoftware/module-manager": "^1.0"},
  "autoload": {"psr-4": {"Liberu\\ControlPanel\\Files\\": "src/"}},
  "extra": {"liberu": {"name": "control-panel-files"}},
  "version": "1.0.0",
  "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
