{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "liberusoftware/module-control-panel-certificates-filament",
  "description": "Filament adapter for Control Panel Certificates.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {"php": "^8.5", "filament/filament": "^5.0", "liberusoftware/module-control-panel-certificates": "^1.0"},
  "autoload": {"psr-4": {"Liberu\\ControlPanel\\CertificatesFilament\\": "src/"}},
  "extra": {"liberu": {"name": "control-panel-certificates-filament", "filament": {"plugin": "Liberu\\ControlPanel\\CertificatesFilament\\CertificatesFilamentPlugin"}}},
  "version": "1.0.0",
  "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
}
