{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "liberusoftware/module-control-panel-control-core",
  "description": "Control Panel nodes, capabilities, credentials, inventory and operation coordination.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "phpseclib/phpseclib": "^3.0",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\ControlPanel\\ControlCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\ControlPanel\\ControlCore\\Tests\\": "tests/"
    }
  },
  "extra": {
    "liberu": {
      "name": "control-panel-control-core"
    }
  },
  "version": "1.0.0",
  "scripts": {
    "test": "pest"
  },
  "require-dev": {
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
