{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "liberusoftware/module-control-panel-control-core-api",
  "description": "Authenticated API adapter for Control Panel Control Core.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "liberusoftware/module-control-panel-control-core": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\ControlPanel\\ControlCoreApi\\": "src/"
    }
  },
  "extra": {"liberu": {"name": "control-panel-control-core-api"}},
  "version": "1.0.0",
  "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
}
