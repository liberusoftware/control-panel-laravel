{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "liberusoftware/module-control-panel-backups-filament",
  "description": "Filament adapter for Control Panel Backups.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {"php": "^8.5", "filament/filament": "^5.0", "liberusoftware/module-control-panel-backups": "^1.0"},
  "autoload": {"psr-4": {"Liberu\\ControlPanel\\BackupsFilament\\": "src/"}},
  "extra": {"liberu": {"name": "control-panel-backups-filament", "filament": {"plugin": "Liberu\\ControlPanel\\BackupsFilament\\BackupsFilamentPlugin"}}},
  "version": "1.0.0",
  "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
}
