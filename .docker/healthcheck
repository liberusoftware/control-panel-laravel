#!/usr/bin/env sh
set -eu

case "${CONTAINER_MODE:-http}" in
    http)
        exec curl --fail --silent --max-time 4 http://127.0.0.1:8000/up
        ;;
    horizon)
        exec supervisorctl -s http://127.0.0.1:9001 status horizon:horizon_0
        ;;
    reverb)
        exec php -r '$socket = @fsockopen("127.0.0.1", (int) (getenv("REVERB_SERVER_PORT") ?: 8080), $errno, $error, 4); if (! $socket) { exit(1); } fclose($socket);'
        ;;
    worker|scheduler)
        mode="${CONTAINER_MODE}"
        exec supervisorctl -s http://127.0.0.1:9001 status "$mode:${mode}_0"
        ;;
    *) exit 1 ;;
esac
